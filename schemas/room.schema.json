{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Room",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "position": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "name",
    "position"
  ],
  "additionalProperties": false
}
