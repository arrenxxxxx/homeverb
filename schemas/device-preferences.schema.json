{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevicePreferences",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "alias": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 80
    },
    "room_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "favorite": {
      "type": "boolean"
    },
    "position": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "device_id",
    "alias",
    "room_id",
    "favorite",
    "position"
  ],
  "additionalProperties": false
}
