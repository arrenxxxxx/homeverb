{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "native-open",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "data_dir": {
      "type": "string",
      "minLength": 1
    },
    "allow_mock_writes": {
      "type": "boolean"
    },
    "scenario": {
      "enum": [
        "normal",
        "reject",
        "lost-ack",
        "accept-only",
        "lan-offline",
        "offline",
        "slow-before-send",
        "slow-after-send",
        "stale-read",
        "partial",
        "correlated-completion"
      ]
    },
    "adapter": {
      "enum": [
        "homeverb.mock",
        "midea.meiju"
      ],
      "default": "homeverb.mock"
    },
    "meiju_power_grants": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "state": {
            "type": "boolean"
          }
        },
        "required": [
          "device_id",
          "state"
        ],
        "additionalProperties": false
      },
      "description": "Trusted startup-only permission for one local device and exact power state over cloud. No wildcard, arbitrary action, provider identifier or confirmation flag. Empty grants no power permission."
    },
    "meiju_fan_grants": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "wind_speed": {
            "type": "integer",
            "enum": [
              20,
              40,
              60,
              80,
              100,
              102
            ]
          }
        },
        "required": [
          "device_id",
          "wind_speed"
        ],
        "additionalProperties": false
      },
      "description": "Trusted startup-only permission for one local AC and one reviewed vendor wind_speed code over cloud. Independent of power grants; never a percentage, wildcard or ordinary request field."
    },
    "meiju_mode_grants": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "cool",
              "heat",
              "auto",
              "dry",
              "fan"
            ]
          }
        },
        "required": [
          "device_id",
          "mode"
        ],
        "additionalProperties": false
      },
      "description": "Trusted startup-only permission to turn on one exact local AC and activate one reviewed vendor mode over cloud. This includes power-on; it grants no independent power, fan or temperature action."
    }
  },
  "required": [
    "schema_version",
    "data_dir",
    "allow_mock_writes"
  ],
  "additionalProperties": false,
  "description": "Trusted native startup. data_dir must be an absolute private OS path. adapter defaults to homeverb.mock; scenario defaults to normal. Meiju defaults to read-only; optional meiju_power_grants, meiju_fan_grants and meiju_mode_grants separately admit exact-device power, fan and explicit power-on/mode activation over cloud. Meiju rejects Mock grants or fault scenarios. Opening never authenticates, discovers or controls.",
  "allOf": [
    {
      "if": {
        "properties": {
          "adapter": {
            "const": "midea.meiju"
          }
        },
        "required": [
          "adapter"
        ]
      },
      "then": {
        "properties": {
          "allow_mock_writes": {
            "const": false
          },
          "scenario": {
            "const": "normal"
          }
        }
      },
      "else": {
        "properties": {
          "meiju_power_grants": {
            "maxItems": 0
          },
          "meiju_fan_grants": {
            "maxItems": 0
          },
          "meiju_mode_grants": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
