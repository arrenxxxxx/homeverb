{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "native-open",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "data_dir": {
      "type": "string",
      "minLength": 1
    },
    "allow_mock_writes": {
      "type": "boolean"
    },
    "scenario": {
      "enum": [
        "normal",
        "reject",
        "lost-ack",
        "accept-only",
        "lan-offline",
        "offline",
        "slow-before-send",
        "slow-after-send",
        "stale-read",
        "partial",
        "correlated-completion"
      ]
    },
    "adapter": {
      "enum": [
        "homeverb.mock",
        "midea.meiju"
      ],
      "default": "homeverb.mock"
    }
  },
  "required": [
    "schema_version",
    "data_dir",
    "allow_mock_writes"
  ],
  "additionalProperties": false,
  "description": "Trusted native startup. data_dir must be an absolute private OS path. adapter defaults to homeverb.mock; scenario defaults to normal. midea.meiju uses saved accounts for read-only cloud access and rejects Mock grants or fault scenarios. Opening never authenticates or discovers.",
  "allOf": [
    {
      "if": {
        "properties": {
          "adapter": {
            "const": "midea.meiju"
          }
        },
        "required": [
          "adapter"
        ]
      },
      "then": {
        "properties": {
          "allow_mock_writes": {
            "const": false
          },
          "scenario": {
            "const": "normal"
          }
        }
      }
    }
  ]
}
