    "mijia_fan_grants": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "component_id": {
            "type": "string",
            "pattern": "^fan-[1-9][0-9]{0,9}$"
          },
          "property": {
            "enum": [
              "state",
              "level",
              "mode",
              "horizontal_swing",
              "horizontal_angle",
              "horizontal_swing_included_angle_6",
              "vertical_swing_7",
              "vertical_swing_included_angle_8",
              "anion_9"
            ]
          },
          "value": {
            "type": [
              "boolean",
              "number"
            ]
          }
        },
        "required": [
          "device_id",
          "component_id",
          "property",
          "value"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "property": {
                  "enum": [
                    "state",
                    "horizontal_swing",
                    "vertical_swing_7",
                    "anion_9"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                }
              }
            },
            "else": {
              "properties": {
                "value": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "property": {
                  "const": "horizontal_swing_included_angle_6"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "integer",
                  "enum": [
                    60,
                    90,
                    120
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "property": {
                  "const": "vertical_swing_included_angle_8"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "integer",
                  "enum": [
                    60,
                    105,
                    120
                  ]
                }
              }
            }
          }
        ]
      }
    },
