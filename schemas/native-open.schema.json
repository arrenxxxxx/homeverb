{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "native-open",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "data_dir": {
      "type": "string",
      "minLength": 1
    },
    "allow_mock_writes": {
      "type": "boolean"
    },
    "scenario": {
      "enum": [
        "normal",
        "reject",
        "lost-ack",
        "accept-only",
        "lan-offline",
        "offline",
        "slow-before-send",
        "slow-after-send",
        "stale-read",
        "partial",
        "correlated-completion",
        "approval-required"
      ]
    },
    "adapter": {
      "enum": [
        "homeverb.mock",
        "midea.meiju",
        "xiaomi.mijia",
        "homeverb.platforms"
      ],
      "default": "homeverb.mock"
    },
    "meiju_power_grants": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "state": {
            "type": "boolean"
          }
        },
        "required": [
          "device_id",
          "state"
        ],
        "additionalProperties": false
      },
      "description": "Trusted startup-only permission for one local device and exact power state over cloud. No wildcard, arbitrary action, provider identifier or confirmation flag. Empty grants no power permission."
    },
    "meiju_fan_grants": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "wind_speed": {
            "type": "integer",
            "enum": [
              20,
              40,
              60,
              80,
              100,
              102
            ]
          }
        },
        "required": [
          "device_id",
          "wind_speed"
        ],
        "additionalProperties": false
      },
      "description": "Trusted startup-only permission for one local AC and one reviewed vendor wind_speed code over cloud. Independent of power grants; never a percentage, wildcard or ordinary request field."
    },
    "meiju_mode_grants": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "cool",
              "heat",
              "auto",
              "dry",
              "fan"
            ]
          }
        },
        "required": [
          "device_id",
          "mode"
        ],
        "additionalProperties": false
      },
      "description": "Trusted startup-only permission to turn on one exact local AC and activate one reviewed vendor mode over cloud. This includes power-on; it grants no independent power, fan or temperature action."
    },
    "meiju_temperature_grants": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "target_temperature": {
            "type": "number",
            "minimum": 16,
            "maximum": 30,
            "multipleOf": 0.5
          }
        },
        "required": [
          "device_id",
          "target_temperature"
        ],
        "additionalProperties": false
      },
      "description": "Trusted startup-only permission for one exact local AC and Celsius target over cloud. This union of reviewed setpoints does not define device capability bounds; the protected product mapping and action schema must also admit the target. No power, mode, fan or other target authority."
    },
    "meiju_dishwasher_grants": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "arguments": {
            "type": "object",
            "properties": {
              "program": {
                "type": "string",
                "enum": [
                  "auto_wash",
                  "strong_wash",
                  "standard_wash",
                  "eco_wash",
                  "glass_wash",
                  "90min_wash",
                  "fast_wash",
                  "soak_wash",
                  "hour_wash",
                  "quietnight_wash",
                  "germ",
                  "self_clean",
                  "fruit_wash",
                  "soft_wash",
                  "single_disinfect",
                  "seafood_wash",
                  "hotpot_wash"
                ]
              },
              "additional": {
                "type": "integer",
                "enum": [
                  0,
                  9,
                  10,
                  13,
                  14
                ]
              }
            },
            "required": [
              "program"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "device_id",
          "arguments"
        ],
        "additionalProperties": false
      },
      "description": "Trusted startup-only exact dishwasher start permission over cloud. The selected protected profile further limits programs and requires or forbids additional. Every start also requires the separate trusted user approval path; ordinary execution remains denied."
    },
    "meiju_dishwasher_cycle_grants": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "action": {
            "type": "string",
            "enum": [
              "pause_cycle",
              "resume_cycle",
              "cancel_cycle",
              "power_on",
              "power_off"
            ]
          },
          "arguments": {
            "type": "object",
            "properties": {
              "additional": {
                "type": "integer",
                "enum": [
                  0,
                  9,
                  10,
                  13,
                  14
                ]
              }
            },
            "additionalProperties": false,
            "default": {}
          }
        },
        "required": [
          "device_id",
          "action"
        ],
        "additionalProperties": false
      },
      "description": "Trusted startup-only exact dishwasher cycle action and arguments over cloud. Omitted arguments mean exactly {}. Product 760Y0026 requires explicit additional; other admitted profiles forbid it. Requires reviewed protected product evidence and separate trusted confirmation. Grants no program start or other cycle action."
    },
