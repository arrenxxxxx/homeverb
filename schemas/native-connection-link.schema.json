{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "native-connection-link",
  "description": "Trusted controller functions only. Public connection metadata and consent cannot replace protected adapter evidence. Production Mock and Meiju refuse linking.",
  "$defs": {
    "prepare": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180000
        },
        "device_id": {
          "type": "string",
          "minLength": 1
        },
        "anchor_id": {
          "type": "string",
          "minLength": 1
        },
        "connection": {
          "$ref": "urn:homeverb:schema:device#/properties/connections/items"
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "timeout_ms",
        "device_id",
        "anchor_id",
        "connection"
      ],
      "additionalProperties": false
    },
    "confirm": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180000
        },
        "link_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "timeout_ms",
        "link_id"
      ],
      "additionalProperties": false
    },
    "preview": {
      "type": "object",
      "properties": {
        "link_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "descriptor": {
          "$ref": "urn:homeverb:schema:native-response#/$defs/describe_device/oneOf/0/properties/data"
        },
        "anchor": {
          "$ref": "urn:homeverb:schema:device#/properties/connections/items"
        },
        "connection": {
          "$ref": "urn:homeverb:schema:device#/properties/connections/items"
        },
        "transport_grants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "device_id": {
                "type": "string",
                "minLength": 1
              },
              "component_id": {
                "type": "string",
                "minLength": 1
              },
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "transports": {
                "type": "array",
                "items": {
                  "enum": [
                    "lan",
                    "cloud"
                  ]
                },
                "uniqueItems": true
              },
              "argument_schema": {
                "type": [
                  "object",
                  "boolean"
                ]
              }
            },
            "required": [
              "device_id",
              "component_id",
              "capability",
              "action",
              "transports",
              "argument_schema"
            ],
            "additionalProperties": false
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "link_id",
        "descriptor",
        "anchor",
        "connection",
        "transport_grants",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "prepare_result": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "1.0"
            },
            "data": {
              "$ref": "#/$defs/preview"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "error": {
              "type": "null"
            }
          },
          "required": [
            "schema_version",
            "data",
            "warnings",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "urn:homeverb:schema:native-response#/$defs/query_error"
        }
      ]
    },
    "confirm_result": {
      "$ref": "urn:homeverb:schema:native-response#/$defs/describe_device"
    }
  }
}
