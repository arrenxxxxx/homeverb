{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommandResult",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "accepted",
        "verified",
        "failed",
        "unknown",
        "partial"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "anyOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Error",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "suggested_action": {
              "type": "string",
              "minLength": 1
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "verification": {
      "anyOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Verification",
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "state_match",
                "correlated_completion"
              ]
            },
            "source": {
              "enum": [
                "lan",
                "cloud"
              ]
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "received_at": {
              "type": "string",
              "format": "date-time"
            },
            "matches_target": {
              "const": true
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "source",
            "received_at",
            "matches_target"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "attempts": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Attempt",
        "type": "object",
        "properties": {
          "transport": {
            "enum": [
              "lan",
              "cloud"
            ]
          },
          "phase": {
            "enum": [
              "not_sent",
              "possibly_sent",
              "accepted",
              "rejected"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "transport",
          "phase",
          "duration_ms"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#"
      },
      "minItems": 2
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "device_id",
    "status",
    "started_at",
    "completed_at",
    "data",
    "error",
    "verification",
    "attempts"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Verification",
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "state_match",
                  "correlated_completion"
                ]
              },
              "source": {
                "enum": [
                  "lan",
                  "cloud"
                ]
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "received_at": {
                "type": "string",
                "format": "date-time"
              },
              "matches_target": {
                "const": true
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "source",
              "received_at",
              "matches_target"
            ],
            "additionalProperties": false
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "failed",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Error",
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "suggested_action": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "allOf": [
              {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "Error",
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "suggested_action": {
                    "type": "string",
                    "minLength": 1
                  },
                  "details": {
                    "type": "object"
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ],
                "additionalProperties": false
              },
              {
                "properties": {
                  "retryable": {
                    "const": false
                  }
                }
              }
            ]
          },
          "verification": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "required": [
          "items"
        ]
      },
      "else": {
        "not": {
          "required": [
            "items"
          ]
        }
      }
    }
  ]
}
