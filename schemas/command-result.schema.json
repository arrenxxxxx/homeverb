{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommandResult",
  "description": "A command receipt, also returned unchanged inside a successful local execution-lookup query. Query success does not change or imply success of the stored command outcome.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "description": "The caller ID or an internal composite correlation ID derived by appending a colon and step index. Internal IDs may exceed the 256-byte caller-input limit.",
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "accepted",
        "verified",
        "failed",
        "unknown",
        "partial"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "anyOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Error",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "suggested_action": {
              "type": "string",
              "minLength": 1
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "verification": {
      "anyOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "Verification",
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "state_match",
                "correlated_completion"
              ],
              "description": "state_match compares observed values. correlated_completion reports adapter-validated successful completion of this exact command on its selected connection; acknowledgement alone is insufficient."
            },
            "source": {
              "enum": [
                "lan",
                "cloud"
              ]
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "received_at": {
              "type": "string",
              "format": "date-time"
            },
            "matches_target": {
              "description": "For state_match, validated observed values equal the requested values without coercion or approximate tolerance. For correlated_completion, the adapter established successful completion of the entire correlated command; this does not assert current state or exactly-once execution.",
              "const": true
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "source",
            "received_at",
            "matches_target"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "attempts": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Attempt",
        "type": "object",
        "properties": {
          "transport": {
            "enum": [
              "lan",
              "cloud"
            ]
          },
          "phase": {
            "enum": [
              "not_sent",
              "possibly_sent",
              "accepted",
              "rejected"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "transport",
          "phase",
          "duration_ms"
        ],
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#"
      },
      "minItems": 2
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Infrastructure diagnostics that do not erase known outcomes, verification evidence, or composite items."
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "device_id",
    "status",
    "started_at",
    "completed_at",
    "data",
    "error",
    "verification",
    "attempts"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Verification",
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "state_match",
                  "correlated_completion"
                ],
                "description": "state_match compares observed values. correlated_completion reports adapter-validated successful completion of this exact command on its selected connection; acknowledgement alone is insufficient."
              },
              "source": {
                "enum": [
                  "lan",
                  "cloud"
                ]
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "received_at": {
                "type": "string",
                "format": "date-time"
              },
              "matches_target": {
                "const": true,
                "description": "For state_match, validated observed values equal the requested values without coercion or approximate tolerance. For correlated_completion, the adapter established successful completion of the entire correlated command; this does not assert current state or exactly-once execution."
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "source",
              "received_at",
              "matches_target"
            ],
            "additionalProperties": false
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "failed",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Error",
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "suggested_action": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "allOf": [
              {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "Error",
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryable": {
                    "type": "boolean"
                  },
                  "suggested_action": {
                    "type": "string",
                    "minLength": 1
                  },
                  "details": {
                    "type": "object"
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable"
                ],
                "additionalProperties": false
              },
              {
                "properties": {
                  "retryable": {
                    "const": false
                  }
                }
              }
            ]
          },
          "verification": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "required": [
          "items"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "items"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "status": {
                  "const": "verified"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        },
        "required": [
          "items"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "status": {
                  "const": "accepted"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "items"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "const": "NOT_EXECUTED"
              }
            },
            "required": [
              "code"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "failed"
          },
          "attempts": {
            "maxItems": 0
          },
          "verification": {
            "type": "null"
          }
        }
      }
    }
  ]
}
