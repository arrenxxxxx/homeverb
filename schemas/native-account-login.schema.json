{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:homeverb:schema:native-account-login",
  "title": "Protected interactive Mijia account login",
  "$defs": {
    "begin": {
      "description": "Protected metadata for the dedicated interactive Mijia login entry point.",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180000
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "account_id": {
          "description": "Explicit local account for same-subject reauthorization. API 1.8 permits pending credentials only with intact protected identity and unchanged saved bindings. Null never opts into pending-account recovery.",
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "const": "xiaomi.mijia"
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "timeout_ms",
        "label",
        "provider"
      ],
      "additionalProperties": false
    },
    "continue": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180000
        },
        "challenge_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "schema_version",
        "operation_id",
        "timeout_ms",
        "challenge_id"
      ],
      "additionalProperties": false
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "1.0"
            },
            "data": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "connected"
                    },
                    "report": {
                      "type": "object",
                      "properties": {
                        "account": {
                          "$ref": "urn:homeverb:schema:native-response#/$defs/account_summary"
                        },
                        "authentication": {
                          "const": "succeeded"
                        },
                        "retrieval": {
                          "$ref": "urn:homeverb:schema:native-response#/$defs/account_retrieval"
                        }
                      },
                      "required": [
                        "account",
                        "authentication",
                        "retrieval"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "report"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "captcha"
                    },
                    "challenge_id": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 18446744073709551615
                    },
                    "image_base64": {
                      "type": "string",
                      "minLength": 4,
                      "maxLength": 174764,
                      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
                    },
                    "media_type": {
                      "enum": [
                        "image/png",
                        "image/jpeg"
                      ]
                    },
                    "expires_in_ms": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 180000
                    }
                  },
                  "required": [
                    "kind",
                    "challenge_id",
                    "image_base64",
                    "media_type",
                    "expires_in_ms"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "error": {
              "type": "null"
            }
          },
          "required": [
            "schema_version",
            "data",
            "warnings",
            "error"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "urn:homeverb:schema:native-response#/$defs/query_error"
        }
      ]
    }
  }
}
