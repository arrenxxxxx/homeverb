{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoomAssignment",
  "type": "object",
  "properties": {
    "device_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "room_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "device_ids",
    "room_id"
  ],
  "additionalProperties": false
}
