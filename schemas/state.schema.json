{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StateSnapshot",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "component_id": {
      "type": "string",
      "minLength": 1
    },
    "from_cache": {
      "type": "boolean"
    },
    "observations": {
      "type": "object",
      "additionalProperties": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Observation",
        "type": "object",
        "properties": {
          "value": {},
          "source": {
            "enum": [
              "lan",
              "cloud"
            ]
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          }
        },
        "required": [
          "value",
          "source",
          "observed_at",
          "received_at",
          "stale"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "device_id",
    "component_id",
    "from_cache",
    "observations",
    "warnings"
  ],
  "additionalProperties": false
}
